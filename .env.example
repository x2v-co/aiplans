DATABASE_URL=postgresql://planprice:password@localhost:5432/planprice
DB_POOL_MAX=10
DB_PREPARE=true
EXCHANGE_RATE_API_KEY=replace-me

# Optional Google measurement and Search Console integration.
# NEXT_PUBLIC_GA_ID is a GA4 Measurement ID such as G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Optional AdSense setup. Leave empty until Google assigns the account's
# publisher ID. When set, /ads.txt serves the authorized seller record.
GOOGLE_ADSENSE_PUBLISHER_ID=
