    {
      "table": "models",
      "name": "models_pricing_unit_chk",
      "kind": "c",
      "definition": "CHECK ((pricing_unit = ANY (ARRAY['per_1m_tokens'::text, 'per_second'::text, 'per_minute'::text, 'per_generation'::text, 'per_credit'::text, 'per_compute_hour'::text, 'subscription_only'::text, 'unknown'::text, 'per_hour'::text, 'per_megapixel'::text, 'per_image'::text, 'per_1k_characters'::text])))"
