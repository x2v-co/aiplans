      "table": "api_channel_prices",
      "name": "channel_prices_currency_check",
      "kind": "c",
      "definition": "CHECK (((currency)::text = ANY ((ARRAY['USD'::character varying, 'CNY'::character varying, 'EUR'::character varying, 'GBP'::character varying, 'JPY'::character varying, 'KRW'::character varying, 'SGD'::character varying])::text[])))"
    },
