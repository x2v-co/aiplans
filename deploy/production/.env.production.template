# PostgreSQL container credentials. Keep this file mode 600 on the VPS.
POSTGRES_DB=planprice
POSTGRES_USER=planprice
POSTGRES_PASSWORD=replace-with-a-long-random-password

# App runtime
HOST_APP_PORT=3000
DB_POOL_MAX=10
DB_PREPARE=true

# Catalog read and management hosts are separate deployments. Never use the
# catalog token for management writes; management credentials must be at least
# 32 random characters and are supplied only to the admin deployment.
PLANPRICE_CATALOG_TOKEN=replace-with-a-long-random-read-token
PLANPRICE_SERVICE_ROLE=public
PLANPRICE_ADMIN_HOST=
EXCHANGE_RATE_API_KEY=
PLANPRICE_V1_SNAPSHOT_HOST_DIR=/opt/x2v/planprice/snapshots
PLANPRICE_V1_SNAPSHOT_PATH=/var/lib/planprice/snapshots/current.json
PLANPRICE_V1_SNAPSHOT_DIR=/var/lib/planprice/snapshots
PLANPRICE_V1_FX_PATH=/var/lib/planprice/snapshots/exchange-rates.json
PLANPRICE_FX_MAX_AGE_HOURS=30

# Optional Google measurement and Search Console integration.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
