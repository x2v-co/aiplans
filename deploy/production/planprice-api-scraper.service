[Unit]
Description=PlanPrice high-frequency API pricing and new model refresh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# Failure/recovery alerts come from the host-level drop-in
# /etc/systemd/system/<unit>.service.d/10-notify.conf -> notify-failure@%n.service
# (fleet-wide template, installed outside this repo since 2026-10-09).

[Service]
Type=oneshot
WorkingDirectory=/opt/x2v/planprice
Environment=DOCKER_CMD=/usr/bin/docker
Environment=SKIP_PLANS=1
Environment=SKIP_AUDIT=1
Environment=SKIP_ARENA=1
Environment=SKIP_BENCHMARKS=1
Environment=SKIP_CODING_AGENTS=1
ExecStart=/opt/x2v/planprice/deploy/production/run-scrapers.sh
TimeoutStartSec=20min
Nice=10
