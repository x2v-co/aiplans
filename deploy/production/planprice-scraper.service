[Unit]
Description=PlanPrice daily pricing, plans, audit, and Agent Arena refresh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# Failure/recovery alerts come from the fleet-wide host drop-in (not this repo):
# /etc/systemd/system/<unit>.service.d/10-notify.conf
#   [Unit]    OnFailure=notify-failure@%n.service
#   [Service] ExecStopPost=-+/usr/local/bin/notify-failure --post %n   (root; recovery notice)
# routed by /etc/notify-failure/routes (planprice-* -> x2v_alerts_bot, [aiplans]).

[Service]
Type=oneshot
WorkingDirectory=/opt/x2v/planprice
Environment=DOCKER_CMD=/usr/bin/docker
ExecStart=/opt/x2v/planprice/deploy/production/run-scrapers.sh
TimeoutStartSec=50min
Nice=10
