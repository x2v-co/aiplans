[Unit]
Description=aiplans official quota-text monitor (snapshots + Feishu change alerts)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# Failure alerts come from the fleet-wide host drop-in, as for planprice-scraper.service.
# Per-source fetch failures do not fail the unit; only all-sources-failed or DB errors do.

[Service]
Type=oneshot
WorkingDirectory=/opt/x2v/planprice
# Reuse x2v alerts configuration: FEISHU_ALERT_WEBHOOK_URL is primary;
# BRAIN_TG_TOKEN / BRAIN_TG_CHAT_ID provide optional fallback. "-" = optional file.
# Prod path is under /root (mode 600). Ubuntu path first as optional fallback;
# later EnvironmentFile wins for duplicate keys, so root overrides when both exist.
EnvironmentFile=-/home/ubuntu/.config/x2v-alerts/env
EnvironmentFile=-/root/.config/x2v-alerts/env
ExecStart=/usr/bin/docker compose -p planprice-production -f /opt/x2v/planprice/deploy/production/compose.yml --env-file /opt/x2v/planprice/deploy/production/.env.production run --rm -e FEISHU_ALERT_WEBHOOK_URL -e BRAIN_TG_TOKEN -e BRAIN_TG_CHAT_ID -e QUOTA_MONITOR_STATE_FILE=/var/lib/planprice/snapshots/quota-monitor-state.json scraper npm run quota:monitor -- --apply
TimeoutStartSec=15min
Nice=10
